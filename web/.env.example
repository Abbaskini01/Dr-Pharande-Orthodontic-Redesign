# Public site origin. Used for canonical URLs, Open Graph URLs, sitemap.xml,
# robots.txt and the JSON-LD structured data.
# No trailing slash. Falls back to https://drpharande.com when unset.
NEXT_PUBLIC_SITE_URL=

# Optional: clinic-approved online booking destination (for example the
# practice's booking platform). When set, the "Book Consultation" dialog shows
# "Book Online" and links here. When empty, the dialog shows the verified
# phone booking option instead.
NEXT_PUBLIC_BOOKING_ONLINE_URL=

# Optional: clinic-approved concierge / chat destination. Set this only once the
# clinic confirms the number or platform is live (it is rendered as a WhatsApp
# or chat link). When empty, the dialog shows the verified email option instead.
NEXT_PUBLIC_CONCIERGE_CHAT_URL=
